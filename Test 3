--==================================================
-- GOD MODE
--==================================================

local GodButton

local function StopGod()
	godEnabled = false

	if godConnection then
		godConnection:Disconnect()
		godConnection = nil
	end

	if GodButton then
		GodButton.Text = "God Mode : OFF"
	end
end

local function StartGod()
	if not Humanoid then
		return
	end

	godEnabled = true

	godConnection = Humanoid.HealthChanged:Connect(function(health)
		if godEnabled and health < Humanoid.MaxHealth then
			Humanoid.Health = Humanoid.MaxHealth
		end
	end)

	Humanoid.Health = Humanoid.MaxHealth

	GodButton.Text = "God Mode : ON"
end

GodButton = CreateButton(
	"God Mode : OFF",
	Color3.fromRGB(200, 150, 0),
	function()
		if godEnabled then
			StopGod()
		else
			StartGod()
		end
	end
)

