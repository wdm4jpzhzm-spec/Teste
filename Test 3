--==================================================
-- CRÉATION DES BOUTONS
--==================================================

local ButtonNumber = 0

local function CreateButton(text, color, action)
	ButtonNumber += 1

	local btn = Instance.new("TextButton")

	btn.Name = "Button_" .. ButtonNumber
	btn.Size = UDim2.new(1, 0, 0, 70)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 20
	btn.BorderSizePixel = 0
	btn.LayoutOrder = ButtonNumber
	btn.AutoButtonColor = true

	btn.Parent = ButtonContainer

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 6)
	Corner.Parent = btn

	-- Une seule connexion : fonctionne souris + tactile
	btn.Activated:Connect(function()
		action()
	end)

	return btn
end

--==================================================
-- FLY
--==================================================

local FlyButton

local function StopFly()
	flyEnabled = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if RootPart then
		local velocity = RootPart:FindFirstChild("MenuFlyVelocity")
		if velocity then
			velocity:Destroy()
		end
	end

	if FlyButton then
		FlyButton.Text = "Mode Vol : OFF"
	end
end

local function StartFly()
	if not Character or not Humanoid or not RootPart then
		return
	end

	flyEnabled = true

	local BodyVelocity = Instance.new("BodyVelocity")
	BodyVelocity.Name = "MenuFlyVelocity"
	BodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
	BodyVelocity.Velocity = Vector3.zero
	BodyVelocity.Parent = RootPart

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flyEnabled or not Character or not RootPart then
			return
		end

		local moveDirection = Humanoid.MoveDirection

		if moveDirection.Magnitude > 0 then
			BodyVelocity.Velocity = moveDirection * 60
		else
			BodyVelocity.Velocity = Vector3.zero
		end
	end)

	FlyButton.Text = "Mode Vol : ON"
end

FlyButton = CreateButton(
	"Mode Vol : OFF",
	Color3.fromRGB(50, 50, 150),
	function()
		if flyEnabled then
			StopFly()
		else
			StartFly()
		end
	end
)

