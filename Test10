-- 3. SYSTÈME DE CELLES (FONCTIONS UTILES)
local function CreateCell(Category, Text, Value)
    local Cell = Instance.new("TextButton")
    Cell.Name = Category
    Cell.Text = Text
    Cell.Size = UDim2.new(1, 0, 1/Category, 0) -- Divise la hauteur
    Cell.BackgroundTransparency = 0.5
    Cell.Font = Enum.Font.Gotham
    Cell.TextColor3 = Color3.fromRGB(255, 255, 255)
    Cell.TextSize = 12
    Cell.Parent = Panel

    local function UpdateVal(val)
        -- Le système interne pour sauvegarder les valeurs
        if Cell.Value then
            Cell.Value = Cell.Value + (val or 0)
        else
            Cell.Value = val
        end
    end

    local function Apply()
        if Cell.Value then
            -- Ici on appliquerait l'info (simulé pour la structure)
            print(Text .. " set to " .. tostring(Cell.Value))
        end
    end

    Cell.ClickDetector = true
    Cell.MouseButton1Click:Connect(function()
        Cell.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
        Cell.TextColor3 = Color3.fromRGB(255, 255, 255)
        Cell.TextTransparency = 1
        Wait(0.1)
        Cell.TextTransparency = 0
    end)
    
    return Cell
end

