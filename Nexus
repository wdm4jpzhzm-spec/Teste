local function CreateToggle(parent, text, default, callback)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 0, 42)
	button.BackgroundColor3 = PANEL2
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = parent

	Corner(button, 9)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -75, 1, 0)
	label.Position = UDim2.fromOffset(12, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.TextColor3 = TEXT
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = button

	local state = Instance.new("TextLabel")
	state.Size = UDim2.fromOffset(52, 25)
	state.Position = UDim2.new(1, -62, 0.5, -12)
	state.Font = Enum.Font.GothamBold
	state.TextSize = 11
	state.Parent = button

	local enabled = default == true

	local function Update()
		state.Text = enabled and "ON" or "OFF"
		state.TextColor3 = enabled and GREEN or MUTED
	end

	Update()

	button.Activated:Connect(function()
		enabled = not enabled
		Update()

		if callback then
			callback(enabled)
		end
	end)

	return button, function()
		return enabled
	end
end

local function CreateSlider(parent, text, min, max, default, callback)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 58)
	holder.BackgroundColor3 = PANEL2
	holder.Parent = parent

	Corner(holder, 9)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -20, 0, 25)
	label.Position = UDim2.fromOffset(10, 3)
	label.BackgroundTransparency = 1
	label.Text = text .. ": " .. tostring(default)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 12
	label.TextColor3 = TEXT
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = holder

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -20, 0, 6)
	bar.Position = UDim2.fromOffset(10, 39)
	bar.BackgroundColor3 = BG
	bar.Parent = holder

	Corner(bar, 5)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = ACCENT
	fill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
	fill.Parent = bar

	Corner(fill, 5)

	local draggingSlider = false

	local function SetValue(value)
		value = math.clamp(value, min, max)
		value = math.floor(value * 100) / 100

		local alpha = (value - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		label.Text = text .. ": " .. tostring(value)

		if callback then
			callback(value)
		end
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			draggingSlider = true

			local x = math.clamp(
				(input.Position.X - bar.AbsolutePosition.X)
				/ bar.AbsoluteSize.X,
				0,
				1
			)

			SetValue(min + (max - min) * x)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not draggingSlider then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local x = math.clamp(
			(input.Position.X - bar.AbsolutePosition.X)
			/ bar.AbsoluteSize.X,
			0,
			1
		)

		SetValue(min + (max - min) * x)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)

	return holder
end

