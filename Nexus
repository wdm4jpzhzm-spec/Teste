local Open = false

local function OpenMenu()
	if Open then
		return
	end

	Open = true
	Main.Visible = true

	Main.Size = UDim2.fromOffset(320, 415)

	TweenService:Create(
		Main,
		TweenInfo.new(
			0.22,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(350, 455)
		}
	):Play()
end

local function CloseMenu()
	if not Open then
		return
	end

	Open = false

	local tween = TweenService:Create(
		Main,
		TweenInfo.new(
			0.18,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),
		{
			Size = UDim2.fromOffset(320, 415)
		}
	)

	tween:Play()

	tween.Completed:Connect(function()
		if not Open then
			Main.Visible = false
		end
	end)
end

NexusButton.Activated:Connect(function()
	if Open then
		CloseMenu()
	else
		OpenMenu()
	end
end)

Close.Activated:Connect(CloseMenu)

