local OriginalPromptDuration = {}

local function UpdatePrompt(prompt)
	if not prompt:IsA("ProximityPrompt") then
		return
	end

	if OriginalPromptDuration[prompt] == nil then
		OriginalPromptDuration[prompt] = prompt.HoldDuration
	end

	if Config.InstantInteract then
		prompt.HoldDuration = 0
	else
		prompt.HoldDuration =
			OriginalPromptDuration[prompt]
	end
end

local function RefreshPrompts()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			UpdatePrompt(obj)
		end
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("ProximityPrompt") then
		task.wait()

		if OriginalPromptDuration[obj] == nil then
			OriginalPromptDuration[obj] =
				obj.HoldDuration
		end

		UpdatePrompt(obj)
	end
end)

