--========================================================--
-- FLY SYSTEM
--========================================================--

local function UpdateFly()
    if not Config.Fly then
        return
    end

    if not RootPart or not RootPart.Parent then
        return
    end

    if not Humanoid then
        return
    end

    local attachment =
        RootPart:FindFirstChild("NexusFlyAttachment")

    if not attachment then
        attachment = Instance.new("Attachment")
        attachment.Name = "NexusFlyAttachment"
        attachment.Parent = RootPart
    end

    local velocity =
        RootPart:FindFirstChild("NexusFlyVelocity")

    if not velocity then
        velocity = Instance.new("LinearVelocity")
        velocity.Name = "NexusFlyVelocity"
        velocity.Attachment0 = attachment
        velocity.RelativeTo = Enum.ActuatorRelativeTo.World
        velocity.MaxForce = math.huge
        velocity.VectorVelocity = Vector3.zero
        velocity.Parent = RootPart
    end

    local move = Humanoid.MoveDirection

    if move.Magnitude < 0.05 then
        velocity.VectorVelocity = Vector3.zero
        return
    end

    local Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    local look = Camera.CFrame.LookVector
    local right = Camera.CFrame.RightVector

    local flatLook =
        Vector3.new(look.X, 0, look.Z)

    if flatLook.Magnitude < 0.01 then
        flatLook = Vector3.new(0, 0, -1)
    else
        flatLook = flatLook.Unit
    end

    local flatRight =
        Vector3.new(right.X, 0, right.Z)

    if flatRight.Magnitude < 0.01 then
        flatRight = Vector3.new(1, 0, 0)
    else
        flatRight = flatRight.Unit
    end

    local forwardAmount =
        move:Dot(flatLook)

    local rightAmount =
        move:Dot(flatRight)

    local direction =
        flatLook * forwardAmount
        + flatRight * rightAmount

    local vertical =
        look.Y * math.abs(forwardAmount)

    direction += Vector3.new(
        0,
        vertical,
        0
    )

    if direction.Magnitude > 0.01 then
        direction =
            direction.Unit * Config.FlySpeed
    end

    velocity.VectorVelocity = direction
end

