--========================================================--
-- AIMBOT
--========================================================--

local function IsValidAimTarget(player)
    if not player then
        return false
    end

    if player == LocalPlayer then
        return false
    end

    local char = player.Character

    if not char then
        return false
    end

    local hum =
        char:FindFirstChildOfClass("Humanoid")

    local root =
        char:FindFirstChild("HumanoidRootPart")

    local head =
        char:FindFirstChild("Head")

    if not hum or hum.Health <= 0 then
        return false
    end

    if not root or not head then
        return false
    end

    if not RootPart then
        return false
    end

    if Config.TeamCheck
        and LocalPlayer.Team ~= nil
        and player.Team ~= nil
        and player.Team == LocalPlayer.Team then

        return false
    end

    local distance =
        (RootPart.Position - root.Position).Magnitude

    if distance > Config.AimDistance then
        return false
    end

    return true
end

local function GetBestAimTarget()
    local Camera = workspace.CurrentCamera

    if not Camera then
        return nil
    end

    local bestTarget = nil
    local bestScreenDistance = Config.AimFOV

    local viewport = Camera.ViewportSize

    local center = Vector2.new(
        viewport.X / 2,
        viewport.Y / 2
    )

    for _, player in ipairs(Players:GetPlayers()) do
        if IsValidAimTarget(player) then

            local char = player.Character

            local head =
                char and char:FindFirstChild("Head")

            if head then
                local screenPosition, onScreen =
                    Camera:WorldToViewportPoint(
                        head.Position
                    )

                if onScreen
                    and screenPosition.Z > 0 then

                    local screenDistance =
                        (
                            Vector2.new(
                                screenPosition.X,
                                screenPosition.Y
                            ) - center
                        ).Magnitude

                    if screenDistance <= bestScreenDistance then
                        bestScreenDistance =
                            screenDistance

                        bestTarget = player
                    end
                end
            end
        end
    end

    return bestTarget
end

local function UpdateAimbot()
    if not Config.Aimbot then
        LockedTarget = nil
        return
    end

    local Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    -- Cherche une cible si aucune n'est verrouillée
    if not IsValidAimTarget(LockedTarget) then
        LockedTarget = GetBestAimTarget()
    end

    if not LockedTarget then
        return
    end

    local character =
        LockedTarget.Character

    local head =
        character and character:FindFirstChild("Head")

    if not head then
        LockedTarget = nil
        return
    end

    local viewport = Camera.ViewportSize

    local center = Vector2.new(
        viewport.X / 2,
        viewport.Y / 2
    )

    local screenPosition, onScreen =
        Camera:WorldToViewportPoint(
            head.Position
        )

    if not onScreen or screenPosition.Z <= 0 then
        LockedTarget = nil
        return
    end

    local screenDistance =
        (
            Vector2.new(
                screenPosition.X,
                screenPosition.Y
            ) - center
        ).Magnitude

    if screenDistance > Config.AimFOV then
        LockedTarget = nil
        return
    end

    local targetCFrame =
        CFrame.lookAt(
            Camera.CFrame.Position,
            head.Position
        )

    Camera.CFrame =
        Camera.CFrame:Lerp(
            targetCFrame,
            math.clamp(
                Config.AimSmoothness,
                0.01,
                1
            )
        )
end

