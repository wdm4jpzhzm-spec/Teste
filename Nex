local ToggleObjects = {}

local function CreateToggle(parent, text, default, callback)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -4, 0, 48)
    Row.BackgroundColor3 = Color3.fromRGB(14, 21, 36)
    Row.Parent = parent

    Corner(Row, 10)

    local Label = CreateLabel(
        Row,
        text,
        13,
        UDim2.new(0, 13, 0, 11)
    )

    Label.Size = UDim2.new(1, -75, 0, 25)

    local Switch = Instance.new("TextButton")
    Switch.Size = UDim2.fromOffset(45, 24)
    Switch.Position = UDim2.new(1, -57, 0.5, -12)
    Switch.Text = ""
    Switch.AutoButtonColor = false
    Switch.Parent = Row

    Corner(Switch, 20)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.fromOffset(18, 18)
    Knob.Position = UDim2.new(0, 3, 0.5, -9)
    Knob.BackgroundColor3 = Color3.fromRGB(210, 220, 235)
    Knob.Parent = Switch

    Corner(Knob, 20)

    local State = default

    local function UpdateVisual()
        if State then
            Tween(Switch, 0.18, {
                BackgroundColor3 = Color3.fromRGB(35, 125, 235)
            }):Play()

            Tween(Knob, 0.18, {
                Position = UDim2.new(1, -21, 0.5, -9)
            }):Play()
        else
            Tween(Switch, 0.18, {
                BackgroundColor3 = Color3.fromRGB(45, 52, 68)
            }):Play()

            Tween(Knob, 0.18, {
                Position = UDim2.new(0, 3, 0.5, -9)
            }):Play()
        end
    end

    Switch.Activated:Connect(function()
        State = not State

        UpdateVisual()

        if callback then
            callback(State)
        end
    end)

    UpdateVisual()

    ToggleObjects[text] = {
        Get = function()
            return State
        end,

        Set = function(value)
            State = value
            UpdateVisual()

            if callback then
                callback(State)
            end
        end
    }

    return Row
end

