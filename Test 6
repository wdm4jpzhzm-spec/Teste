local function CreateTextButton(parent, text, y, callback)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -10, 0, 38)
	Button.Position = UDim2.new(0, 5, 0, y)
	Button.BackgroundColor3 = Color3.fromRGB(22, 29, 42)
	Button.Text = text
	Button.TextColor3 = Color3.fromRGB(225, 230, 240)
	Button.TextSize = 12
	Button.Font = Enum.Font.GothamMedium
	Button.AutoButtonColor = true
	Button.ZIndex = 13
	Button.Parent = parent

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 7)
	Corner.Parent = Button

	Button.MouseButton1Click:Connect(callback)

	return Button
end

local function CreateToggle(parent, text, y, callback)
	local enabled = false

	local Button = CreateTextButton(parent, text .. " : OFF", y, function()
		enabled = not enabled

		if enabled then
			Button.Text = text .. " : ON"
			Button.TextColor3 = Color3.fromRGB(90, 190, 255)
		else
			Button.Text = text .. " : OFF"
			Button.TextColor3 = Color3.fromRGB(225, 230, 240)
		end

		callback(enabled)
	end)

	return Button
end

local function ClearContent()
	for _, child in ipairs(Content:GetChildren()) do
		child:Destroy()
	end
end

