local PageFrames = {}
local TabButtons = {}

local function CreatePage(name)
    local Page = Instance.new("ScrollingFrame")
    Page.Name = name
    Page.Size = UDim2.new(1, -12, 1, -12)
    Page.Position = UDim2.fromOffset(6, 6)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = Color3.fromRGB(40, 130, 230)
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.Visible = false
    Page.Parent = Pages

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 7)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Parent = Page

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.fromOffset(0, Layout.AbsoluteContentSize.Y + 10)
    end)

    PageFrames[name] = Page
    return Page
end

local function CreateTab(name, icon)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.fromOffset(84, 38)
    Button.BackgroundColor3 = Color3.fromRGB(18, 26, 39)
    Button.Text = icon .. "  " .. name
    Button.TextColor3 = Color3.fromRGB(180, 195, 215)
    Button.TextSize = 11
    Button.Font = Enum.Font.GothamMedium
    Button.AutoButtonColor = false
    Button.Parent = Sidebar

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Button

    TabButtons[name] = Button

    return Button
end

local function ShowPage(name)
    for pageName, page in pairs(PageFrames) do
        page.Visible = pageName == name
    end

    for tabName, button in pairs(TabButtons) do
        if tabName == name then
            button.BackgroundColor3 = Color3.fromRGB(30, 100, 180)
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            button.BackgroundColor3 = Color3.fromRGB(18, 26, 39)
            button.TextColor3 = Color3.fromRGB(180, 195, 215)
        end
    end

    CurrentPage = name
    LastPage = name
end

