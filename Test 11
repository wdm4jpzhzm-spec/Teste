local function CreateToggle(parent, text, default, callback)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -5, 0, 48)
	button.BackgroundColor3 = Color3.fromRGB(12, 21, 35)
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = parent

	Corner(button, 12)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -70, 1, 0)
	label.Position = UDim2.fromOffset(16, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.GothamSemibold
	label.TextSize = 13
	label.TextColor3 = Color3.fromRGB(210, 220, 235)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = button

	local state = Instance.new("TextLabel")
	state.Size = UDim2.fromOffset(42, 24)
	state.Position = UDim2.new(1, -55, .5, -12)
	state.BackgroundColor3 = default
		and Color3.fromRGB(25, 130, 220)
		or Color3.fromRGB(35, 43, 55)
	state.Text = default and "ON" or "OFF"
	state.Font = Enum.Font.GothamBold
	state.TextSize = 9
	state.TextColor3 = Color3.new(1,1,1)
	state.Parent = button

	Corner(state, 8)

	local enabled = default
	ToggleObjects[text] = button

	local function Set(value)
		enabled = value

		state.Text = value and "ON" or "OFF"

		Tween(state, .15, {
			BackgroundColor3 = value
				and Color3.fromRGB(25, 130, 220)
				or Color3.fromRGB(35, 43, 55)
		})

		callback(value)
	end

	button.MouseButton1Click:Connect(function()
		Set(not enabled)
	end)

	return button, Set
end

