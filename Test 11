local function Stroke(parent, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.Color = Color3.fromRGB(55, 150, 255)
	s.Parent = parent
