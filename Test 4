	Stroke(Button, Color3.fromRGB(50, 60, 75), 1)

	local Label = Instance.new("TextLabel")

	Label.Size = UDim2.new(1, -75, 1, 0)
	Label.Position = UDim2.new(0, 14, 0, 0)

	Label.BackgroundTransparency = 1
	Label.Text = text
	Label.TextColor3 = WHITE
	Label.Font = Enum.Font.GothamSemibold
	Label.TextSize = 14
	Label.TextXAlignment = Enum.TextXAlignment.Left

	Label.Parent = Button

	local State = Instance.new("TextLabel")

	State.Size = UDim2.new(0, 55, 0, 28)
	State.Position = UDim2.new(1, -65, 0.5, -14)

	State.BackgroundColor3 = default and GREEN or Color3.fromRGB(55, 60, 70)

	State.Text = default and "ON" or "OFF"

	State.TextColor3 = WHITE
	State.Font = Enum.Font.GothamBold
	State.TextSize = 11

	State.Parent = Button

	Corner(State, 7)

	local enabled = default

	local function Refresh()
		State.Text = enabled and "ON" or "OFF"
		State.BackgroundColor3 = enabled and GREEN or Color3.fromRGB(55, 60, 70)
	end

	Button.Activated:Connect(function()

		enabled = not enabled

		Refresh()

		callback(enabled)

	end)

	return Button
end

