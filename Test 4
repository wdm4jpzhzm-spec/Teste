-- MAIN PAGE
--========================================================

local function MainPage()

	ClearContent()

	Section("MOVEMENT")

	CreateToggle("FLY • Full Control", false, function(enabled)

		if enabled then
			StartFly()
			FlyControls.Visible = true
		else
			StopFly()
			FlyControls.Visible = false
		end

	end)

	CreateToggle("NOCLIP", false, function(enabled)

		NoclipEnabled = enabled

		if NoclipConnection then
			NoclipConnection:Disconnect()
			NoclipConnection = nil
		end

		if enabled then

			NoclipConnection = RunService.Stepped:Connect(function()

				if Character then

					for _, part in ipairs(Character:GetDescendants()) do

						if part:IsA("BasePart") then
							part.CanCollide = false
						end

					end

				end

			end)

		end

	end)

	CreateToggle("INFINITE JUMP", false, function(enabled)

		InfiniteJumpEnabled = enabled

		if JumpConnection then
			JumpConnection:Disconnect()
			JumpConnection = nil
		end

		if enabled then

			JumpConnection = UserInputService.JumpRequest:Connect(function()

				if Humanoid then
					Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end

			end)

		end

	end)

	CreateValue("SPEED", WalkSpeed, function(value)

		WalkSpeed = value

		if Humanoid then
			Humanoid.WalkSpeed = WalkSpeed
		end

	end)

	CreateValue("JUMP POWER", JumpPower, function(value)

		JumpPower = value

		if Humanoid then
			Humanoid.UseJumpPower = true
			Humanoid.JumpPower = JumpPower
		end

	end)

	CreateToggle("GOD MODE", false, function(enabled)

		GodEnabled = enabled

		if GodConnection then
			GodConnection:Disconnect()
			GodConnection = nil
		end

		if enabled then

			GodConnection = Humanoid.HealthChanged:Connect(function()

				if Humanoid.Health < Humanoid.MaxHealth then
					Humanoid.Health = Humanoid.MaxHealth
				end

			end)

		end

	end)

	Section("TELEPORT")

	local TP = Instance.new("TextButton")

	TP.Size = UDim2.new(1, -5, 0, 48)
	TP.BackgroundColor3 = BG3
	TP.Text = "📍  RANDOM TELEPORT"
	TP.TextColor3 = WHITE
	TP.Font = Enum.Font.GothamBold
	TP.TextSize = 14

	TP.Parent = Content

	Corner(TP, 7)

	TP.Activated:Connect(function()

		if RootPart then

			local x = math.random(-150, 150)
			local z = math.random(-150, 150)

			RootPart.CFrame =
				CFrame.new(x, RootPart.Position.Y + 5, z)

		end

	end)

	local Spawn = Instance.new("TextButton")

	Spawn.Size = UDim2.new(1, -5, 0, 48)
	Spawn.BackgroundColor3 = BG3
	Spawn.Text = "🏠  TP SPAWN"
	Spawn.TextColor3 = WHITE
	Spawn.Font = Enum.Font.GothamBold
	Spawn.TextSize = 14

	Spawn.Parent = Content

	Corner(Spawn, 7)

	Spawn.Activated:Connect(function()

		if RootPart then

			RootPart.CFrame = CFrame.new(0, 10, 0)

		end

	end)

end

