local function CreateToggle(text, default, callback)

	local Button = Instance.new("TextButton")

	Button.Size = UDim2.new(1, -5, 0, 48)

	Button.BackgroundColor3 = BG3
	Button.Text = ""
	Button.AutoButtonColor = false

	Button.Parent = Content

