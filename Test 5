		UDim2.new(1, -65, 0.5, -14)

	State.BackgroundColor3 =
		default and GREEN
		or Color3.fromRGB(55, 60, 70)

	State.Text =
		default and "ON" or "OFF"

	State.TextColor3 = WHITE

	State.Font =
		Enum.Font.GothamBold

