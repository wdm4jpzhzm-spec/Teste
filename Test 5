				GodConnection =
					Humanoid.HealthChanged:Connect(
						function()

							if Humanoid.Health <
								Humanoid.MaxHealth then

								Humanoid.Health =
									Humanoid.MaxHealth

							end

						end
					)

			end

		end
	)

