local function StopFly()

	FlyEnabled = false
	FlyUp = false
	FlyDown = false

	if FlyConnection then

		FlyConnection:Disconnect()
		FlyConnection = nil

	end

	if RootPart then

		local Velocity =
			RootPart:FindFirstChild(
				"NexusFlyVelocity"
			)

		if Velocity then
			Velocity:Destroy()
		end

	end

end

local function StartFly()

	if not RootPart or not Humanoid then
		return
	end

	StopFly()

	FlyEnabled = true

	local Velocity =
		Instance.new("BodyVelocity")

	Velocity.Name =
		"NexusFlyVelocity"

	Velocity.MaxForce =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	Velocity.Velocity =
		Vector3.zero

	Velocity.Parent = RootPart

	FlyConnection =
		RunService.RenderStepped:Connect(
			function()

				if not FlyEnabled
					or not RootPart then
					return
				end

				local Direction =
					Humanoid.MoveDirection

				local Result =
					Vector3.zero

				if Direction.Magnitude > 0 then

					Result =
						Direction.Unit
						* FlySpeed

				end

				if FlyUp then

					Result +=
						Vector3.new(
							0,
							FlySpeed,
							0
						)

				end

				if FlyDown then

					Result +=
						Vector3.new(
							0,
							-FlySpeed,
							0
						)

				end

				Velocity.Velocity =
					Result

			end
		)

end

